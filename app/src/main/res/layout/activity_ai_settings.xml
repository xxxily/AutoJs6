<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:theme="@style/AppTheme.AppBarOverlay">

        <org.autojs.autojs.theme.widget.ThemeColorToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ToolBarStyle"
            app:popupTheme="@style/AppTheme.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <org.autojs.autojs.theme.widget.ThemeColorSwitch
                android:id="@+id/switch_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ai_enable_assistant" />

            <TextView
                android:id="@+id/text_provider_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?android:textColorSecondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button_manage_providers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/text_ai_manage_providers" />

            <Button
                android:id="@+id/button_test_provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ai_test_default_provider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/text_ai_context_options"
                android:textAppearance="@style/TextAppearance.AppCompat.Body2"
                android:textColor="?android:textColorSecondary" />

            <org.autojs.autojs.theme.widget.ThemeColorCheckBox
                android:id="@+id/check_full_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/text_ai_allow_full_file_context" />

            <org.autojs.autojs.theme.widget.ThemeColorCheckBox
                android:id="@+id/check_project_structure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ai_allow_project_structure" />

            <org.autojs.autojs.theme.widget.ThemeColorCheckBox
                android:id="@+id/check_recent_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ai_allow_recent_logs" />

            <org.autojs.autojs.theme.widget.ThemeColorCheckBox
                android:id="@+id/check_clipboard_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ai_allow_clipboard_context" />

            <org.autojs.autojs.theme.widget.ThemeColorCheckBox
                android:id="@+id/check_ui_snapshot_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ai_allow_ui_snapshot_context" />

            <org.autojs.autojs.theme.widget.ThemeColorCheckBox
                android:id="@+id/check_screen_capture_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ai_allow_screen_capture_context" />

            <org.autojs.autojs.theme.widget.ThemeColorCheckBox
                android:id="@+id/check_ocr_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ai_allow_ocr_context" />

            <org.autojs.autojs.theme.widget.ThemeColorCheckBox
                android:id="@+id/check_high_risk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ai_high_risk_confirmation" />

            <EditText
                android:id="@+id/input_max_context"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/text_ai_max_context_chars"
                android:inputType="number" />

            <EditText
                android:id="@+id/input_max_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/text_ai_max_log_chars"
                android:inputType="number" />

            <Button
                android:id="@+id/button_save_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/text_save" />

            <Button
                android:id="@+id/button_clear_ai_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_ai_clear_cache" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
